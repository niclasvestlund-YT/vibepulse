/*
 * Kopiera till secrets.h i repytroten och fyll i. secrets.h är gitignorad —
 * känsligt stannar på den här disken.
 *
 * Notera vad som INTE finns här: inga API-tokens. Solelkollens endpoints är
 * publika och VibePulse-tjänsten bor på ditt eget LAN, så en stulen eller
 * borttappad skärm läcker exakt ingenting utöver ditt WiFi-lösenord — och
 * det roterar du i routern, inte i molnet.
 */
#ifndef TORGET_SECRETS_H
#define TORGET_SECRETS_H

/* Plattformen: WiFi (2,4 GHz — S3:an hör inget annat). */
#define TG_WIFI_SSID   ""
#define TG_WIFI_PASS   ""

/* Reservnät, t.ex. telefonens internetdelning — kortet växlar automatiskt
 * dit efter ~4 missar på hemmanätet (och tillbaka på samma vis). Tomt =
 * funktionen är av. OBS iPhone: slå på "Maximera kompatibilitet" i
 * Internetdelning, annars sänder telefonen bara 5 GHz som S3:an inte hör.
 * OBS Tokenmätaren: TK_TOKENS_URL pekar på Macens IP på HEMMANÄTET — på
 * hotspot får Macen annan adress, så den vyn visar streck där (ärligt). */
#define TG_WIFI2_SSID  ""
#define TG_WIFI2_PASS  ""

/* Solelkollen-appen. */
#define SG_GLANCE_URL  "https://solelkollen.se/api/glance"
/* Valfri: Sverige-vyns endpoint. Odefinerad härleds prod-adressen i appens
 * net.c — sätt bara denna om du pekar mot något annat än solelkollen.se. */
/* #define SG_SVERIGE_URL "https://solelkollen.se/api/glance-sverige" */

/* VibePulse: Mac-tjänsten på LAN:et (tools/tokenserver). Odefinerad
 * startar ingen hämttask och vyn står ärligt med streck. */
/* #define TK_TOKENS_URL  "http://192.168.1.XX:8737/api/tokens" */
/* #define TK_AGENT_STATUS_URL \
   "http://192.168.1.XX:8737/api/agent-status" */

#endif
