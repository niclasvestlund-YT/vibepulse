/*
 * Kopiera till secrets.h i repytroten och fyll i. secrets.h är gitignorad —
 * känsligt stannar på den här disken.
 *
 * Notera vad som INTE finns här: inga API-tokens. VibePulse-tjänsten bor på
 * ditt eget LAN, så en stulen eller borttappad skärm läcker ditt
 * WiFi-lösenord och LAN-namnet på din Mac — båda roterar du själv, inte i
 * molnet.
 */
#ifndef TORGET_SECRETS_H
#define TORGET_SECRETS_H

/* Plattformen: WiFi (2,4 GHz — S3:an hör inget annat).
 *
 * De här två är panelens OFÖRÄNDERLIGA BOTTEN, inte hela nätlistan. Sedan
 * setupfönstret finns (docs/wifi.md) minns panelen sex platser i NVS och
 * lär sig nya på plats — utan ombygge, utan USB. Botten kan bara läggas
 * till, aldrig tas bort, så en trasig nätpost kan aldrig göra skärmen
 * ounderhållbar. Fyll i hemnätet här; resten sköts av tools/wifi-here.sh
 * eller panelens egen accesspunkt. */
#define TG_WIFI_SSID   ""
#define TG_WIFI_PASS   ""

/* Andra bottennätet, t.ex. telefonens internetdelning — kortet växlar
 * automatiskt dit efter ~4 missar (och tillbaka på samma vis). Tomt =
 * funktionen är av. OBS iPhone: slå på "Maximera kompatibilitet" i
 * Internetdelning, annars sänder telefonen bara 5 GHz som S3:an inte hör.
 *
 * Hotspoten är det enda nät som ALLTID fungerar på resa (hotellens
 * captive portals och klientisolering stoppar panelen oavsett hur lätt
 * den är att koppla upp). Den behöver inte stå här längre — panelen minns
 * den lika bra via setupfönstret — men här överlever den en NVS-radering. */
#define TG_WIFI2_SSID  ""
#define TG_WIFI2_PASS  ""

/* VibePulse: tjänsten på LAN:et (tools/tokenserver, macOS/Windows/Linux).
 *
 * Ny firmware hittar automatiskt friska tokenservrar som annonserar
 * _vibepulse._tcp.local. Adressen nedan är den oförändrade reservvägen när
 * multicast eller den valfria värdannonsen saknas. Byt DIN-MAC mot Macens
 * Bonjour-namn — inte en IP-adress. Namnet visas av:
 *   scutil --get LocalHostName
 *
 * På Windows kan reservvägen vara en DHCP-reserverad LAN-adress; den normala
 * stabila vägen är `requirements-discovery.txt` på varje tokenservervärd.
 * Flera Mac/PC får annonsera samtidigt: panelen håller sig till en frisk värd
 * och byter först när den slutar svara.
 *
 * URL:erna är AVSIKTLIGT aktiva här: en odefinierad URL kompilerar bort
 * hämttasken helt, och då bootar skärmen glatt och visar streck för evigt
 * utan ett enda felmeddelande. Hellre fel värdnamn (som syns i loggen) än en
 * tyst avstängd app. */
#define TK_VIBEPULSE_BASE_URL \
     "http://DIN-MAC.local:8737"
#define TK_TOKENS_URL \
     TK_VIBEPULSE_BASE_URL "/api/tokens"
#define TK_AGENT_STATUS_URL \
     TK_VIBEPULSE_BASE_URL "/api/agent-status"
#define TK_MAX_TRACKER_URL \
     TK_VIBEPULSE_BASE_URL "/api/max-tracker"

/* Valfritt relä: en brevlåda på internet dit tjänsten LÄGGER sina färdiga
 * siffror, så panelen kan hämta dem utan att dela nät med värden. Utan det
 * här makrot beter sig allt exakt som förut — LAN eller ingenting.
 *
 * Varför: panelen kunde bara nå tjänsten på samma nät. Ett gästnät med
 * klientisolering, ett IoT-VLAN eller en dator som bytt IP räckte för att
 * glaset skulle stå tomt (2026-08-17: Solelkollen hämtade glatt över
 * internet medan VibePulse visade streck). Med reläet behöver panelen bara
 * INTERNET — vilket nät som helst, var som helst.
 *
 * Vad som går den vägen: kvot, burn rate, Max Tracker, GitHub. Alltså
 * siffror. Den här nummertransporten får aldrig agentstatus, Needs You,
 * projektnamn, frågetext eller kommandon. Fjärrbeslut använder i stället det
 * separata krypterade interaktionsreläet längst ned i filen, endast efter ett
 * uttryckligt val; Cloudflare får då faststor krypterad text, inte klartext.
 *
 * Sökvägen ska bära minst 32 slumpade byte — den ÄR åtkomstkontrollen.
 * Generera med:
 *   python3 -c "import secrets; print(secrets.token_hex(32))"
 * Tjänstens sida sätts på med tools/tokenserver --publish <samma URL>. */
/* #define TK_VIBEPULSE_RELAY_URL \
     "https://vibepulse-relay.exempel.workers.dev/u/replace-with-64-hex" */

/* Optional public GitHub repository module. Configure the repository on the
 * Mac service with --github-repo owner/repository (or the
 * VIBEPULSE_GITHUB_REPO environment variable), then independently choose
 * whether its full-screen Stars/Forks page and star popup are present here.
 *
 * All switches default to off so a fresh clone remains Claude/Codex-only.
 * Notifications work even when the GitHub page is disabled. Sound also
 * requires a platform backend that has passed the unit's speaker/DMA gate. */
#define TK_GITHUB_URL \
     TK_VIBEPULSE_BASE_URL "/api/github"
// New installs start with quota/reset pages and local activity.
// Enable analytics later in SETTINGS > LABS; saved choices survive updates.
#define TK_LABS_ANALYTICS_DEFAULT 0
#define TK_GITHUB_SCREEN_ENABLED 0
#define TK_GITHUB_NOTIFICATIONS_ENABLED 0
#define TK_GITHUB_SOUND_ENABLED 0

/* Companion-appar (egna repon, byggs bara om de finns utcheckade) sätter sina
 * egna endpoints här. Exempel:
 *   #define SG_GLANCE_URL "https://exempel.se/api/glance"
 */

/* Optional local OTA maintenance token. Generate at least 32 random bytes,
 * keep it out of git, and store its counterpart outside Studio project data.
 * Without this macro the upload endpoint remains disabled. */
/* #define TG_OTA_TOKEN "replace-with-64-hex-characters" */

/* Optional "Needs You" device key: lets the panel ANSWER Claude Code's
 * questions and permission prompts instead of only announcing them. The same
 * value must be readable by the tokenserver (it also checks
 * ~/.vibepulse-device-key and the VIBEPULSE_DEVICE_KEY environment variable),
 * which must run with --interactions. Generate with:
 *   python3 -c "import secrets; print(secrets.token_hex(32))"
 *
 * The key authenticates the DEVICE and nothing else. It grants no access to
 * Claude, GitHub or the Mac; the most it can ever do is answer a prompt your
 * machine was already going to ask you about, and never past your own
 * permissions.deny rules. Rotating the value revokes the panel instantly.
 * Without this macro the panel stays display-only and every decision falls
 * back to the terminal. */
/* #define TK_VIBEPULSE_DEVICE_KEY "replace-with-64-hex-characters" */

/* Optional encrypted Needs You and live-status relay. This is separate from
 * the numbers relay above. Approvals remain inert until
 * TK_VIBEPULSE_INTERACTION_RELAY is enabled; live Claude/Codex rows remain
 * inert until the independent TK_VIBEPULSE_AGENT_STATUS_RELAY is enabled.
 * The panel and computer may then use unrelated Wi-Fi. Cloudflare sees only
 * fixed-size ciphertext, short-lived routing IDs and timing; project
 * basenames, activity, questions, commands and verdicts stay E2E encrypted.
 * The device key encrypts content end to end; the panel token can access only
 * this mailbox role. Generate and diagnose the complete block with:
 *   python3 tools/vibepulse_setup.py relay install --url HTTPS_ORIGIN
 *   python3 tools/vibepulse_setup.py relay enable-status --yes-e2e-cloud
 *   python3 tools/vibepulse_setup.py relay doctor
 * Never reuse the Mac token here. */
/* #define TK_VIBEPULSE_INTERACTION_RELAY_URL "https://relay.example.workers.dev" */
/* #define TK_VIBEPULSE_INTERACTION_MAILBOX "vp_replace16charsxx" */
/* #define TK_VIBEPULSE_INTERACTION_PANEL_TOKEN "replace-with-43-base64url-characters" */

#endif
