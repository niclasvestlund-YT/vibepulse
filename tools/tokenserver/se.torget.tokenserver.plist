<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The token meter's service as a launchd agent: starts at login and is
     restarted if it dies. Assumes the repo in ~/Torget and the user
     niclasvestlund; edit both paths otherwise.
     Interaction providers and detail come from the tokenserver's saved config;
     keep them out of ProgramArguments so setup changes cannot go stale here.
     The log lives in ~/Library/Logs (survives a reboot, shows in the
     Console app; /tmp is cleaned by macOS). The server rotates it itself at
     start once it has grown past the cap; launchd has no rotation of its
     own. ThrottleInterval is the fence against respawn loops: if the
     process dies right at start, launchd waits 30 s instead of filling the
     log. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>se.torget.tokenserver</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/niclasvestlund/Torget/.venv/bin/python</string>
    <string>-u</string>
    <string>tokenserver.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/niclasvestlund/Torget/tools/tokenserver</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/niclasvestlund/Library/Logs/torget-tokenserver.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/niclasvestlund/Library/Logs/torget-tokenserver.log</string>
</dict>
</plist>
