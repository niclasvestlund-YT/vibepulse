{
  "manifest_version": 3,
  "name": "VibePulse Lovable Credits",
  "version": "0.1.0",
  "description": "Read visible Lovable credit balances and send numbers to your local VibePulse display.",
  "key": "",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/settings/billing*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VibePulse Lovable credits"
  }
}
