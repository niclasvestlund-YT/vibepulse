# Placeholders only. Load locally into the host service environment.
# Do not commit the real .env; never paste tokens into command lines or logs.
GROKBOT_WEBHOOK_URL=https://YOUR-ROUTINE-HOST/YOUR-ROUTINE-PATH
GROKBOT_WEBHOOK_KEY=REPLACE_WITH_ROUTINE_BEARER_KEY
VIBEPULSE_REPLY_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_REPLY_TOKEN
VIBEPULSE_VOICE_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_DEVICE_TOKEN
VIBEPULSE_VOICE_REQUESTS_PER_HOUR=10
VIBEPULSE_VOICE_SILENCE_MS=900
VIBEPULSE_VOICE_ENERGY=500
VIBEPULSE_STT_MODEL=small
VIBEPULSE_STT_LANGUAGE=auto
VIBEPULSE_TTS=piper
VIBEPULSE_PIPER_MODEL=/ABSOLUTE/LOCAL/PATH/sv_SE-nst-medium.onnx
# Optional cloud TTS. Leave unset for local-only speech synthesis.
# ELEVENLABS_API_KEY=REPLACE_WITH_YOUR_EXISTING_KEY
# ELEVENLABS_VOICE_ID=REPLACE_WITH_YOUR_VOICE_ID
